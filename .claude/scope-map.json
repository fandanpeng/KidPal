        "docs/ARCH-REVIEW-QUEUE.md",
        "docs/CONTRACT-DECISION-QUEUE.md",
        "docs/glossary.md",
        "docs/requirements.md",
        "docs/architecture.md",
        "docs/ADR.md"
      ],
      "allowDirs": [
        "docs/contracts",
        "docs/templates",
        "docs/archive",
        "docs/notes",
        "docs/ui",
        "docs/crq",
        "docs/showme"
      ]
    }
  },
