{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_doc": [
    "KidPal 项目级常驻设置。只放对所有会话生效的【结构红线】钩子。",
    "钩子分三档 settings 文件注册，审计钩子在场性须三处并查、不可只看本文件：本 settings.json=所有会话常驻（结构红线 + advisory injector）；dev-loop.settings.json=仅 dev-loop Pod 会话加载（portfolio-sync PostToolUse、supervisor-gate-check Stop——Stop 合并门钩子刻意不入常驻、以免每次交互收尾都触发）；review-loop.settings.json=仅对抗 review 会话加载（per-agent 边界）。",
    "review-loop 的严格 per-agent 边界在 .claude/review-loop.settings.json，只在跑 review loop 时加载。",
    "enforce-scope.mjs 同时实现 universal（本文件触发）与 per-agent（loop settings 触发）两段；幂等无副作用。",
    "permissions.allow 只收可复用通配条目；一次性命令由会话临时授权承载。",
    "agent-model-guard（ARQ-260907-architect-dispatch-model-override）：PreToolUse(Agent|Task) 拦 architect 派发带 model 参数——planner.md:71「派发不带 model 覆盖」的机械兜底；MODEL-TIER 授权升档（builder/fixer）不拦。逃生门 env KIDPAL_ALLOW_AGENT_MODEL_OVERRIDE=1 仅会话启动者可设。"
  ],
  "permissions": {
    "allow": [
      "mcp__codebase-memory-mcp__*",
      "Bash(node .claude/scripts/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git reset *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git ls-tree *)",
      "Bash(git check-ignore *)",
      "Bash(git rev-list *)",
      "Bash(git worktree *)",
      "Bash(python3 -c *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/deny-main-push.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-safety.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-scope.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/suggest-codebase-memory.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-scope.mjs\""
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent-model-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/planning-sync.mjs\""
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/suggest-codebase-memory.mjs\""
          }
        ]
      }
    ]
  }
}
