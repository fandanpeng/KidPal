# KidPal direction-B gateway secrets (example). Deploy as server/deploy/secrets.env
# (chmod 600) on the ECS; never commit real values. Rendered by apply-xiaozhi-overlay.sh.

# Strong shared device token (决策22: >=22 chars, >=128-bit, constant-time behind auth.py).
# token 未设 = 拒绝服务 (no validation-mode backdoor). Example (REGENERATE in prod):
XIAOZHI_DEVICE_TOKEN=change-me-to-a-random-64-hex-or-more

# OpenClaw brain token (loopback LLM). matches OPENCLAW_TOKEN used by server/shim.py.
OPENCLAW_TOKEN=

# 阿里云云 ASR (决策19 云优先; V23 终选). If these are left unset, live ASR is a known
# credential gap -> escalate to planner (human 待办项), structural shape still declared.
ALIYUN_ASR_APPKEY=
ALIYUN_ASR_TOKEN=
DASHSCOPE_API_KEY=