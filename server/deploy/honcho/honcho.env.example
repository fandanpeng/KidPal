# Honcho 自托管栈环境模板（K3-E1 · 261022-m5-k3-honcho-memory-production）
# 用法：ECS 上复制为 /opt/honcho/.env 并填真实值；凭据只存 ECS、不入仓
#（凭据纪律：以名字引用 + env 注入，本模板零真实 secret）。

# ── postgres（pgvector 本机持久卷）──
POSTGRES_USER=honcho
POSTGRES_DB=honcho
POSTGRES_PASSWORD=            # 必填：仅存 /opt/honcho/.env，不入仓

# ── 出网管线① deriver 抽取 → DeepSeek（NFR-SEC-2 ⑤ 记账）──
DEEPSEEK_API_KEY=             # 必填：仅存 ECS，不入仓
DERIVER_LLM_BASE_URL=https://api.deepseek.com/v1
DERIVER_LLM_MODEL=deepseek-v4-flash
DERIVER_FLUSH_ENABLED=true    # 不冲刷则 observation 永不产出（TECH-261022 证据 7）

# ── 出网管线② embedding 向量化 → DashScope（NFR-SEC-2 ⑤ 记账，与 ASR 同信任域）──
DASHSCOPE_API_KEY=            # 必填：embedding 凭据（沿用 ASR 同源 key），仅存 ECS
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# dashscope text-embedding-v4 须显式维度；pgvector 向量列固定 1536——值漂移 =
# embedding 写入失败（TECH-261022 证据 7 配置要点），禁改。
EMBEDDING_VECTOR_DIMENSIONS=1536
# DashScope 兼容端点 embedding batch 上限 10（Honcho 缺省 max_batch_size=100
# → RepresentationSaveError 成批丢单元，K4 实测 24 单元；锚 = Honcho
# src/embedding_client.py:250 + src/config.py:455 的 EMBEDDING_ 前缀/__ 嵌套）。
# K4B-E5（261024-m5-k4b-corpus-parser-v2）同步入模板；ECS /opt/honcho/.env
# 写入归 live 重灌轮。
EMBEDDING_MODEL_CONFIG__MAX_BATCH_SIZE=10

# ── deriver LLM 截断口径（K4B-E5 注记）──
# ECS live 已把 LLM_DEFAULT_MAX_TOKENS 改 8000、未入仓（debt 2026-10-24 在册，
# review §2.3.3）：模板只留注释口径、不设值（沿用服务端缺省）；live 轮重灌
# 时按 ECS .env 实值核对，EmptyRepresentation 截断残量超阈须显式计数升级。
# LLM_DEFAULT_MAX_TOKENS=8000

# ── api 消费位（OpenClaw Honcho 插件 baseUrl 指本机 loopback）──
HONCHO_API_BASE_URL=http://127.0.0.1:18100
