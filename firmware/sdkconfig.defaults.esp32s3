
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# 包 9b HWV-A6 渲染节点落地: s_p1_fb (400×300×4B=480KB 首页帧缓冲) 经
# __attribute__((section(".ext_ram.bss"))) 置于 PSRAM，避免 ESP32-S3 内部 DRAM
# (~360KB) 溢出。EXT_RAM_BSS_ATTR 需此配置才生效（未开启时该节段链接失败）。
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# HWV 语音轮修复 (fixer, voice-round1.log:29): speaking 期间 esp_timer 任务栈溢出复位。
# 板上 esp_timer 承载 audio_power_timer (含 codec I2C 事务) 与 clock_timer, 3584B 余量过薄;
# 同步抬 FreeRTOS timer service task (供 Ticker/legacy 组件使用)。根因区分靠运行期
# uxTaskGetStackHighWaterMark 埋点 (audio_service.cc), 见包内复验记录。
CONFIG_ESP_TIMER_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y
